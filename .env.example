# Copy this file to .env and change the values if needed:
#   cp .env.example .env

# Address of MongoDB (matches the port in docker-compose.yml)
MONGO_URI=mongodb://localhost:27017

# Name of the database to use
MONGO_DB=data_engineering

# Your contact email. Wikipedia asks API clients to include it in the
# User-Agent header so they can reach you if your script causes problems.
CONTACT_EMAIL=you@example.com
